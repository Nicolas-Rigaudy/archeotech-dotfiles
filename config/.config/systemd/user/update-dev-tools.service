# Daily user-tool updater (req_013 / item_172): claude, npm -g, cdx, pipx,
# uv tools, rtk, codebase-memory-mcp. Linked into
# ~/.config/systemd/user by scripts/install.sh (enable_user_services).
# network-online.target does not cover a resume from suspend: the script
# itself waits for DNS (up to 30 min) and retries failed steps.
[Unit]
Description=Update user-installed dev tools (npm, pipx, uv, claude, rtk, cbm)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/update-dev-tools.sh
# 30 min network wait + ~10 tools (10 min cap per attempt, 3 attempts) fit
# inside this in any realistic run. Exit 1 = a tool failed (notified).
TimeoutStartSec=2h
