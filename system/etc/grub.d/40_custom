#!/bin/sh
exec tail -n +3 $0
# This file provides an easy way to add custom menu entries.  Simply type the
# menu entries you want to add after this comment.  Be careful not to change
# the 'exec tail' line above.

# Custom Fedora entry - kernel is in shared /boot (nvme0n1p3), root is on nvme0n1p7
menuentry 'Fedora Linux 43 (6.17.8-300)' --class fedora --class gnu-linux --class gnu --class os {
    load_video
    insmod gzio
    insmod part_gpt
    insmod ext2
    insmod btrfs

    # Set root to shared /boot partition (nvme0n1p3) to load kernel
    set root='hd0,gpt3'

    # Load Fedora kernel from shared /boot with proper btrfs root
    echo 'Loading Fedora kernel...'
    linux /vmlinuz-6.17.8-300.fc43.x86_64 root=UUID=d7796a39-d288-45e1-beca-144156304cb8 ro rootflags=subvol=root,compress=zstd:1 rhgb quiet

    # Load initramfs from shared /boot
    echo 'Loading initial ramdisk...'
    initrd /intel-ucode.img /initramfs-6.17.8-300.fc43.x86_64.img
}

