/* Wallpaper picker — clean grid, Catppuccin Macchiato glass */

* {
    bg:      rgba(30, 30, 46, 0.88);
    surface: rgba(49, 50, 68, 0.75);
    accent:  #c6a0f6;

    background-color: transparent;
    text-color:       transparent;
    font:             "Sans 1";
}

window {
    transparency:     "real";
    background-color: @bg;
    border:           1px;
    border-color:     @accent;
    border-radius:    16px;
    padding:          16px;
    /* 3 cols × 260px + 2×8px gaps + 32px padding = 828px                */
    width:            828px;
    /* max 2.5 rows visible; shrinks to fit fewer entries on last page     */
    /* 2×260 + 2×8gaps + 130half + 32pad = 698px                          */
    max-height:       698px;
}

mainbox {
    background-color: transparent;
    children:         [ listview ];
}

listview {
    background-color: transparent;
    /* flow: horizontal = fill rows left→right, then next row (like reading order) */
    flow:             horizontal;
    lines:            3;
    columns:          3;
    spacing:          8px;
    padding:          0px;
    scrollbar:        false;
    dynamic:          true;
    fixed-height:     false;
    cycle:            false;
}

element {
    background-color: @surface;
    border-radius:    10px;
    padding:          0px;
    orientation:      vertical;
    cursor:           pointer;
    /* Fixed tile height so rows are always 260px regardless of lines     */
    height:           260px;
}

element normal.normal,
element alternate.normal {
    background-color: @surface;
}

element selected.normal {
    background-color: @surface;
    border:           3px;
    border-color:     @accent;
}

element normal.active,
element alternate.active {
    border:           3px;
    border-color:     #a6e3a1;
}

element selected.active {
    background-color: @surface;
    border:           3px;
    border-color:     #a6e3a1;
}

element-icon {
    background-color: transparent;
    size:             260px;
    border-radius:    10px;
    cursor:           inherit;
    expand:           true;
}

element-text {
    enabled:          false;
}
