/* Generated by theme-switch.py — palette: {{name}}
 * DO NOT EDIT — regenerated on every theme switch.
 * Imported by userChrome.css.
 *
 * TRANSPARENCY is owned by the sameerasw transparency Zen-mod + the
 * `zen.widget.linux.transparency` pref (see profile user.js) — NOT by this
 * file. So we deliberately set only the palette COLORS (via Zen's theming
 * variables) and DO NOT paint solid `background-color` on the chrome
 * containers, which would block the mod's see-through. The glass tint itself
 * is the mod's `mod.sameerasw.zen_transparency_color` setting (configured in
 * the mod's UI); leave it translucent for the wallpaper to read through. */

:root {
  /* ── Active palette (handles for any custom rules) ─────────────────────── */
  --arch-base:     {{base}};
  --arch-mantle:   {{mantle}};
  --arch-crust:    {{crust}};
  --arch-surface0: {{surface0}};
  --arch-text:     {{text}};
  --arch-accent:   {{mauve}};

  /* ── Zen themable surfaces + accent (tints buttons/borders/active states) ── */
  --zen-primary-color:    {{mauve}} !important;
  --zen-colors-primary:   {{base}} !important;
  --zen-colors-secondary: {{mantle}} !important;
  --zen-colors-tertiary:  {{surface0}} !important;

  /* ── Text colors (safe — don't affect transparency) ─────────────────────── */
  --lwt-text-color:         {{text}} !important;
  --toolbar-color:          {{text}} !important;
  --tab-selected-textcolor: {{text}} !important;
  --toolbar-field-color:    {{text}} !important;
}
