--- a/render/fx_renderer/shaders/tex.frag	2026-06-28 07:36:32.000000000 +0200
+++ b/render/fx_renderer/shaders/tex.frag	2026-10-15 15:34:20.000597774 +0200
@@ -47,6 +47,20 @@
 
 uniform bool discard_transparent;
 
+// Coverage-weighted blur: the texture is a blur mask (a layer's own buffer).
+// The blurred backdrop is drawn under the layer with a per-pixel weight w, so
+// that an edge pixel composites exactly as "coverage c of a panel of alpha A":
+//   a*C + (1-a)*(w*blur + (1-w)*sharp)  ==  c*(A*C + (1-A)*blur) + (1-c)*sharp
+// with a = c*A gives w = a*(1-A) / (A*(1-a)). Interior pixels (a >= A) get the
+// full blur; anti-aliased edges and faint shadows get proportionally less.
+// A = coverage_full: the lowest interior alpha of a blurred panel, so every panel
+// body gets the full blur (upstream would make it a parameter).
+uniform bool coverage;
+uniform float coverage_full;
+uniform sampler2D blur_tex;
+uniform vec2 blur_size;
+uniform bool blur_flip;
+
 vec4 sample_texture() {
 #if SOURCE == SOURCE_TEXTURE_RGBA || SOURCE == SOURCE_TEXTURE_EXTERNAL
 	return texture2D(tex, v_texcoord);
@@ -55,6 +68,20 @@
 #endif
 }
 
+vec4 sample_source() {
+	if (coverage) {
+		vec2 uv = gl_FragCoord.xy / blur_size;
+		if (blur_flip) {
+			uv.y = 1.0 - uv.y;
+		}
+		float a = sample_texture().a;
+		float weight = clamp(a * (1.0 - coverage_full)
+			/ (coverage_full * max(1.0 - a, 1e-4)), 0.0, 1.0);
+		return texture2D(blur_tex, uv) * weight;
+	}
+	return sample_texture();
+}
+
 #if EFFECTS
